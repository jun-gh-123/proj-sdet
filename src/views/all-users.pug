doctype html
html
  head
    title All Users
  body
    h1 All Users
    a(href="/users/new", style="margin-bottom: 20px; display: block;") Create New User  
    table#users-table
      thead
        tr
          th Name
          th Email
      tbody
        each user in users
          tr
            td= user.name
            td
              a(href=`/users?email=${user.email}`)=user.email
