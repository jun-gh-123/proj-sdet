doctype html
html
  head
    title Proj SDET: All Users
    style.
      table {
        border-collapse: collapse;
      }
      th, td {
        border: 1px solid black;
        padding: 8px 12px;
      }
  body
    h1 All Users
    a(href="/users/new", style="margin-bottom: 20px; display: block;") Create New User  
    table#users-table
      thead(style="text-align: left;")
        tr
          th Name
          th Email
      tbody
        each user in users
          tr
            td= user.name
            td
              a(href=`/users?email=${user.email}`)=user.email
