doctype html
html
  head
    title Proj SDET: Create User
    style.
      .error-msg {
        color: red;    
      }
      .form-row {
        display: flex;
        gap: 5px;
        align-items: center;
        margin-bottom: 10px;  
      }
  body
    h1 Create User
    
    form(action="/users/new", method="post")
      .form-row
        label(for="name") Name:
        input(type="text", name="name", id="name", value=(formData && formData.name) || '', required)
        if errors.name
          .error-msg #{errors.name}          
      .form-row
        label(for="email") Email:
        input(type="email", name="email", id="email", value=(formData && formData.email) || '', required)
        if errors.email
          .error-msg #{errors.email}
      .form-row
        button(type="submit", id="submit-create-user") Submit

    if errors.form
      .error-msg #{errors.form}

