doctype html

if users[0]
  html
    head
      title Proj SDET: #{users[0].email}
      style.
        form {
          margin-bottom: 20px;
        }
    body
      a(href="/users") Go to all users page
      h1=users[0].email
      form(action="/users/change_name", method="post")
        input(type="hidden", name="email", id="email", value=(users[0].email))
        input(type="text", name="name", id="name", value=(users[0].name))
        button(type="submit", id="submit-change-name") Change Name
      form(action="/users/delete", method="post")
        input(type="hidden", name="email", id="email", value=(users[0].email))
        button(type="submit", id="submit-user-delete") Delete User
else
  html
    head
      title Proj SDET: User Not Found
      body
        h1 User Not Found
        a(href="/users") Go to all users page
